{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "worker:image-optimization": "tsx workers/image_optimization_worker.node.ts",
    "worker:image-cleanup": "tsx workers/image_cleanup_worker.node.ts",
    "worker:analytics": "ANALYTICS_RUN_ONCE=true tsx workers/analytics_nightly_job.node.ts",
    "worker:analytics:continuous": "tsx workers/analytics_nightly_job.node.ts",
    "worker:weekly-emails": "EMAIL_RUN_ONCE=true tsx workers/weekly_email_reports.node.ts",
    "worker:weekly-emails:continuous": "tsx workers/weekly_email_reports.node.ts",
    "worker:webhooks": "WEBHOOK_RUN_ONCE=true tsx workers/webhook_delivery_worker.node.ts",
    "worker:webhooks:continuous": "tsx workers/webhook_delivery_worker.node.ts",
    "test:analytics": "psql \"$DATABASE_URL\" -f tests/analytics_reporting_tests.sql",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:load": "k6 run tests/load/review-submission.js",
    "test:security": "vitest run tests/security",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:refresh-views": "psql \"$DATABASE_URL\" -c \"SELECT refresh_rating_summaries();\""
  },
