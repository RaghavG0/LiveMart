# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://cdvhodymzfwdzfeltmsu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Functions URL (optional - defaults to SUPABASE_URL/functions/v1)
VITE_SUPABASE_FUNCTION_URL=https://cdvhodymzfwdzfeltmsu.supabase.co/functions/v1

# Ola Maps API Key (required for location features)
VITE_OLA_MAPS_API_KEY=your_ola_maps_api_key_here

# ============================================
# VERCEL DEPLOYMENT INSTRUCTIONS:
# ============================================
# 1. Go to: Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Add ALL variables above with actual values (without quotes)
# 3. IMPORTANT: After adding/updating env vars, you MUST REDEPLOY
# 4. Environment variables are only available at BUILD time for Vite
# 5. Make sure variable names start with VITE_ prefix
